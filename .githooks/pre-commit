#!/usr/bin/env python3
"""Format staged Swift files without staging unrelated working-tree edits."""
import os
import shutil
import subprocess
import sys
from pathlib import Path


def git(*args, **kwargs):
    return subprocess.run(["git", "-c", "core.fsmonitor=false", *args], check=True,
                          capture_output=True, **kwargs).stdout


def main():
    root = Path(os.fsdecode(git("rev-parse", "--show-toplevel")).strip())
    os.chdir(root)
    paths = [os.fsdecode(path) for path in git(
        "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"
    ).split(b"\0") if path.endswith(b".swift")]
    if not paths:
        return

    formatter = ["xcrun", "swift-format"] if shutil.which("xcrun") else ["swift-format"]
    config = subprocess.run(["git", "show", ":.swift-format"], capture_output=True, check=False)
    command = [*formatter, "format", "--configuration",
               config.stdout.decode() if config.returncode == 0 else "{}"]
    changes = []
    for path in paths:
        entry = git("ls-files", "--stage", "-z", "--", path).split(b"\0")[0]
        mode, blob, stage = entry.split(b"\t", 1)[0].split()
        if stage != b"0" or mode not in (b"100644", b"100755"):
            continue
        original = git("cat-file", "blob", blob.decode())
        result = subprocess.run([*command, "--assume-filename", path, "-"], input=original,
                                capture_output=True, check=False)
        if result.returncode:
            sys.stderr.buffer.write(result.stderr)
            raise RuntimeError(f"swift-format failed for {path}")
        if result.stdout != original:
            changes.append((path, mode, original, result.stdout))

    # Format every file successfully before changing the index.
    records = []
    for path, mode, original, formatted in changes:
        blob = git("hash-object", "-w", "--stdin", input=formatted).strip()
        records.append(mode + b" " + blob + b"\t" + os.fsencode(path) + b"\0")
    if records:
        git("update-index", "-z", "--index-info", input=b"".join(records))
    for path, mode, original, formatted in changes:
        file = Path(path)
        if not file.is_symlink() and file.is_file() and file.read_bytes() == original:
            file.write_bytes(formatted)
            print(f"swift-format: {path}")
        else:
            print(f"swift-format: {path} (staged content only; unstaged edits preserved)")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"pre-commit: {error}", file=sys.stderr)
        sys.exit(1)
